
# Same value in resolve-rite-console and resolve-rite-web (base64, >= 32 bytes): openssl rand -base64 32
RR_SITE_API_SECRET=

# Where "Sign in" and "Get started" / "Start onboarding" / plan CTAs send visitors: the console's auth pages.
# Unset, they default to ${CONSOLE_URL:-https://console.resolverite.app}/auth/login and /auth/register.
SIGNIN_URL=https://console.resolverite.app/auth/login
SIGNUP_URL=https://console.resolverite.app/auth/register
